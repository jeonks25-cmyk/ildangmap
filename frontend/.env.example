# 일당맵 프론트 — 환경변수 예시 (복사 후 .env.development.local 사용)
# cp .env.example .env.development.local

# === 베타 실연동 (카카오 OAuth via Spring Boot) ===
REACT_APP_USE_MOCK_API=false
REACT_APP_API_BASE_URL=http://localhost:8080
REACT_APP_PUBLIC_URL=http://localhost:3000

# 개발 포트 3001 사용 시 백엔드 FRONTEND_BASE_URL=http://localhost:3001 도 맞춰 주세요.

# 베타 테스트 최소 시드 (5직종·장소·일정)
REACT_APP_BETA_SEED=true

# 카카오 지도 JS 키 (선택 — 미설정 시 코드 내 폴백)
# REACT_APP_KAKAO_MAP_KEY=

# 개발용 Mock 로그인 버튼 (live 모드에서도 표시). 끄려면 false
# REACT_APP_DEV_LOGIN_SHORTCUT=false

# OAuth 시작 전 백엔드 health probe 생략 (로컬만)
# REACT_APP_SKIP_OAUTH_PROBE=true

# --- Vercel 프로덕션 빌드 (Environment Variables) ---
# REACT_APP_API_BASE_URL=https://YOUR-BACKEND-DOMAIN
# REACT_APP_PUBLIC_URL=https://ildangmap.vercel.app
# REACT_APP_USE_MOCK_API=false
# REACT_APP_BETA_SEED=true

# 주의: KAKAO_CLIENT_SECRET 은 프론트에 넣지 마세요. 로그인은
# ${REACT_APP_API_BASE_URL}/oauth2/authorization/kakao 로 Spring에 위임합니다.
