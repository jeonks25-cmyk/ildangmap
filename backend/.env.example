# Spring Boot — 환경변수 예시 (Windows PowerShell)
# $env:KAKAO_CLIENT_ID="REST_API_키"
# $env:KAKAO_CLIENT_SECRET="클라이언트_시크릿"
# $env:FRONTEND_BASE_URL="http://localhost:3000"
# $env:APP_CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001"
# ./gradlew bootRun

KAKAO_CLIENT_ID=YOUR_KAKAO_REST_API_KEY
KAKAO_CLIENT_SECRET=YOUR_KAKAO_CLIENT_SECRET

# 프론트 SPA 주소 (OAuth 성공/실패 후 /auth/callback 리다이렉트)
FRONTEND_BASE_URL=http://localhost:3000
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# 운영 (Vercel + 백엔드 호스팅)
# FRONTEND_BASE_URL=https://ildangmap.vercel.app
# APP_CORS_ALLOWED_ORIGINS=https://ildangmap.vercel.app
# SESSION_COOKIE_SECURE=true
# SPRING_PROFILES_ACTIVE=prod

# DB (MySQL)
DB_URL=jdbc:mysql://localhost:3306/ildangmap?useSSL=false&serverTimezone=Asia/Seoul&characterEncoding=UTF-8&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=1234

# JWT (향후 토큰 방식 전환 시 — 현재는 세션 쿠키 ILDANGMAPSESSION 사용)
JWT_SECRET=change-me-in-production

# 베타 피드백 관리자 (쉼표 구분 user id, users.is_admin 컬럼 없음)
APP_ADMIN_USER_IDS=1,2

# 피드백 첨부 저장 (로컬 Volume — Railway: /data/uploads/feedback)
APP_FEEDBACK_STORAGE_TYPE=local
APP_FEEDBACK_STORAGE_DIR=uploads/feedback

# 카카오 개발자 콘솔 Redirect URI (Spring):
# http://localhost:8080/login/oauth2/code/kakao
# (운영) https://YOUR-BACKEND-DOMAIN/login/oauth2/code/kakao
